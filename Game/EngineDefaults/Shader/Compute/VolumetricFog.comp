layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

float rand(vec2 co){return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);}
float rand (vec2 co, float l) {return rand(vec2(rand(co), l));}
float rand (vec2 co, float l, float t) {return rand(vec2(rand(co, l), t));}

vec3 GetWorldPosition(float depth, vec2 uv)
{
    float a = projection[3][2];
    float b = projection[2][2];

    float zView = - a / ((depth * 2.0 - 1.0) + b);
    
    a = projection[0][0];
    b = projection[1][1];

    float xView = (-zView / a) * (uv.x * 2.0 - 1.0);
    float yView = (-zView / b) * (uv.y * 2.0 - 1.0);

    vec4 worldPosition = inverseViewMatrix *  vec4(xView,yView,zView, 1.0);

    return worldPosition.xyz;
}

// THIS IS TEMPORAL, LATER USE A TEXTURE, SHOULD IMPROVE PERFORMANCE
float noise(vec3 currentPosition, float time)
{
    vec2 pos = floor(currentPosition.xy * currentPosition.z);
	vec2 posx = pos + vec2(1.0, 0.0);
	vec2 posy = pos + vec2(0.0, 1.0);
	vec2 posxy = pos + vec2(1.0);
	
	float c = rand(pos, currentPosition.z, time);
	float cx = rand(posx, currentPosition.z, time);
	float cy = rand(posy, currentPosition.z, time);
	float cxy = rand(posxy, currentPosition.z, time);
	
	vec2 d = fract(currentPosition.xy * currentPosition.z);
	d = -0.5 * cos(d * M_PI) + 0.5;
	
	float ccx = mix(c, cx, d.x);
	float cycxy = mix(cy, cxy, d.x);
	float center = mix(ccx, cycxy, d.y);
	
	return center * 2.0 - 1.0;
}

float CalculateExtinctionCoefficient(vec3 currentPosition)
{
    return extinctionCoefficient * noise(currentPosition, time) * noiseAmmount;
}

float ScatteringPhaseFunction(vec3 viewDirection, vec3 lightDirection)
{
    float k = 1.55 * anisotropy - 0.55 * anisotropy * anisotropy * anisotropy;
    float theta = dot(viewDirection, lightDirection);

    return (1 - k * k) / (4 * M_PI * (1 + k * cos(theta)) * (1 + k * cos(theta)));
}

vec3 CalculateInScattering(vec3 currentPosition, vec3 rayDirection, vec2 uvCoords)
{
    vec3 light = vec3(0.0);
    rayDirection = normalize(rayDirection);

    // DIRECTIONAL LIGHT
    vec4 currentPosFromLight = directinal_Projection_Mat * directinal_View_Mat * vec4(currentPosition, 1.0);
    vec3 projCoords = currentPosFromLight.xyz / currentPosFromLight.w;
    projCoords = projCoords * 0.5 + 0.5;

    if(projCoords.x >= 0.0 && projCoords.x <= 1.0 && projCoords.y >= 0.0 && projCoords.y <= 1.0 && projCoords.z >= 0.0 && projCoords.z <= 1.0)
    {
        float dLightVisibility = texture(directionalLightShadowTexture, projCoords.xy).r;
        light += ScatteringPhaseFunction(-rayDirection, normalize(directional_dir.xyz)) * dLightVisibility * directional_color.rgb;
    }
    
    return light;
}

void main()
{
    const ivec2 textureSize = imageSize(transmitanceTexture);

    if(gl_GlobalInvocationID.x < textureSize.x && gl_GlobalInvocationID.y < textureSize.y)
    {
	    ivec2 tileID = ivec2(gl_WorkGroupID.xy);
	    ivec2 tileNumber = ivec2(gl_NumWorkGroups.xy);
        uint index = tileID.y * tileNumber.x + tileID.x;

        vec2 uvCoords = vec2(gl_GlobalInvocationID.x / float(textureSize.x), gl_GlobalInvocationID.y / float(textureSize.y));
        float depth = texture(depthTexture, uvCoords).r;
        
        vec3 worldPosition = GetWorldPosition(depth, uvCoords);

        vec3 rayDirection = worldPosition - cameraPosition;
        vec3 currentPosition = cameraPosition;

        vec3 marchingStep = rayDirection / float(NUM_STEPS);
        float stepSize = length(marchingStep);

        float accExtintionCoeff = 0.0;
        vec3 accInScattering = vec3(0.0);

        for(int i = 0; i < NUM_STEPS; ++i)
        {
            accExtintionCoeff += CalculateExtinctionCoefficient(currentPosition) * stepSize;
            accInScattering += CalculateInScattering(currentPosition, rayDirection, uvCoords) * stepSize * exp(-accExtintionCoeff);

            currentPosition += marchingStep;
        }

        vec3 finalInScattering = accInScattering * fogIntensity;

        vec4 originalColor = texture(sceneTexture, uvCoords);

        if(depth < 1.f)
        {
            imageStore(transmitanceTexture, ivec2(gl_GlobalInvocationID.xy), vec4(originalColor.rgb + finalInScattering, 1.0));
        }
        else
        {
            imageStore(transmitanceTexture, ivec2(gl_GlobalInvocationID.xy), originalColor);
        }

        // imageStore(transmitanceTexture, ivec2(gl_GlobalInvocationID.xy), vec4(originalColor.rgb, 1.0));
    }
}