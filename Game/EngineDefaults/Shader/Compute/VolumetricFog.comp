// LIGHT CALCULATION FUNCTIONS

float rand(vec2 co){return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);}
float rand (vec2 co, float l) {return rand(vec2(rand(co), l));}
float rand (vec2 co, float l, float t) {return rand(vec2(rand(co, l), t));}

vec3 GetWorldPosition(float depth, vec2 uv)
{
    float a = projection[3][2];
    float b = projection[2][2];

    float zView = - a / ((depth * 2.0 - 1.0) + b);
    
    a = projection[0][0];
    b = projection[1][1];

    float xView = (-zView / a) * (uv.x * 2.0 - 1.0);
    float yView = (-zView / b) * (uv.y * 2.0 - 1.0);

    vec4 worldPosition = inverseViewMatrix *  vec4(xView,yView,zView, 1.0);

    return worldPosition.xyz;
}

// THIS IS TEMPORAL, LATER USE A TEXTURE, SHOULD IMPROVE PERFORMANCE
float noise(vec3 currentPosition, float time)
{
    vec2 pos = floor(currentPosition.xy * currentPosition.z);
	vec2 posx = pos + vec2(1.0, 0.0);
	vec2 posy = pos + vec2(0.0, 1.0);
	vec2 posxy = pos + vec2(1.0);
	
	float c = rand(pos, currentPosition.z, time);
	float cx = rand(posx, currentPosition.z, time);
	float cy = rand(posy, currentPosition.z, time);
	float cxy = rand(posxy, currentPosition.z, time);
	
	vec2 d = fract(currentPosition.xy * currentPosition.z);
	d = -0.5 * cos(d * M_PI) + 0.5;
	
	float ccx = mix(c, cx, d.x);
	float cycxy = mix(cy, cxy, d.x);
	float center = mix(ccx, cycxy, d.y);
	
	return center * 2.0 - 1.0;
}

float SpotLightAttenuation(const SpotLight spot, vec3 pos)
{
	const vec3 dirLight = normalize(spot.direction);
	const float dist = dot(pos - spot.position.xyz, dirLight);
	const float Fatt = pow(max(1 - pow((dist / spot.position.w), 4.0), 0.0), 2.0) / (pow(dist, 2.0) + 1.0);

	const vec3 D = normalize(pos - spot.position.xyz);
	const float C = dot(D, dirLight);

	const float cosInner = cos(radians(spot.innerAngle));
	const float cosOuter = cos(radians(spot.outerAngle));
	float Catt = 0;
	if (C > cosInner) Catt = 1;
	else if (C < cosInner && C > cosOuter) Catt = (C - cosOuter) / (cosInner - cosOuter);

	return Fatt * Catt;
}

bool ValidProjectionCoordinates(vec3 projCoords)
{
    return projCoords.x >= 0.0 && projCoords.x <= 1.0 && projCoords.y >= 0.0 && projCoords.y <= 1.0 && projCoords.z >= 0.0 && projCoords.z <= 1.0;
}

float CalculateExtinctionCoefficient(vec3 currentPosition, vec2 uvCoords)
{
    float noise = useNoiseTex ? texture(noiseTexture, uvCoords + frameTime).r : noise(currentPosition, frameTime);
    return extinctionCoefficient * noise * noiseAmmount;
}

float ScatteringPhaseFunction(vec3 viewDirection, vec3 lightDirection, float anisotropy)
{
    float k = 1.55 * anisotropy - 0.55 * anisotropy * anisotropy * anisotropy;
    float theta = dot(viewDirection, lightDirection);

    return (1 - k * k) / (4 * M_PI * (1 + k * cos(theta)) * (1 + k * cos(theta)));
}

bool SolveQuadratic(in float a, in float b, in float c, out float t0, out float t1)
{
    float discr = b * b - 4 * a * c;

    if (discr < 0) return false;

    else if (discr == 0) t0 = t1 = - 0.5 * b / a;

    else 
    {
        float discrSqrt = sqrt(discr);
        float q;

        if(b > 0)  q = -0.5 * (b + discrSqrt);
        else q = -0.5 * (b - discrSqrt); 
        
        t0 = q / a;
        t1 = c / q;
    }

    if (t0 > t1)
    {
        float tmp = t0;
        t0 = t1;
        t1 = tmp;
    }
    
    return true;
}

bool SpehereIntersection(vec3 center, float radius, vec3 rayOrigin, vec3 rayDirection, out float t0, out float t1)
{
    vec3 L = rayOrigin - center;
    float a = dot(rayDirection, rayDirection); // JUST IN CASE THEY ARE NOT NORMALIZED
    float b = 2.0 * dot(rayDirection, L);
    float c = dot(L, L) - (radius * radius);
    
    if(!SolveQuadratic(a, b, c, t0, t1)) return false;

    if (t0 > t1)
    {
        float tmp = t0;
        t0 = t1;
        t1 = tmp;
    }

    if (t0 < 0) 
    {
        t0 = t1; // If t0 is negative, let's use t1 instead.
        if (t0 < 0) return false; // Both t0 and t1 are negative.
    }

    return true;
}

bool BoxIntersection(vec3 boxCenter, vec3 boxSize, vec3 rayOrigin, vec3 rayDirection)
{
    float tmin, tmax, tymin, tymax, tzmin, tzmax;

    vec3 invDir = 1.0 / rayDirection;

    int signs[3];
    signs[0] = (invDir.x < 0) ? 1 : 0;
    signs[1] = (invDir.y < 0) ? 1 : 0;
    signs[2] = (invDir.z < 0) ? 1 : 0;

    vec3 bounds[2];
    bounds[0] = boxCenter - (boxSize / 2.0);
    bounds[1] = boxCenter + (boxSize / 2.0);

    tmin = (bounds[signs[0]].x - rayOrigin.x) * invDir.x;
    tmax = (bounds[1 - signs[0]].x - rayOrigin.x) * invDir.x;

    tymin = (bounds[signs[1]].y - rayOrigin.y) * invDir.y;
    tymax = (bounds[1 - signs[1]].y - rayOrigin.y) * invDir.y;

    if ((tmin > tymax) || (tymin > tmax)) return false;

    if (tymin > tmin) tmin = tymin;
    if (tymax < tmax) tmax = tymax;

    tzmin = (bounds[signs[2]].z - rayOrigin.z) * invDir.z;
    tzmax = (bounds[1 - signs[2]].z - rayOrigin.z) * invDir.z;

    if ((tmin > tzmax) || (tzmin > tmax))
        return false;

    if (tzmin > tmin) tmin = tzmin;
    if (tzmax < tmax) tmax = tzmax;

    return true;
}

vec3 CalculateInScattering(vec3 currentPosition, vec3 rayDirection, int baseOffset)
{
    vec3 light = vec3(0.0);
    rayDirection = normalize(rayDirection);

    vec4 currentPosFromLight;
    vec3 projCoords;

    for(int i = 0; i < tileLightCount; ++i)
    {
        SpotLight spot = tileSpotLights[i];
        int shadowIndex = spot.spotShadowIndex;
            
        if(shadowIndex < 0) continue;

        currentPosFromLight = spotShadows[shadowIndex].shadowViewProj * vec4(currentPosition, 1.0);
        projCoords = currentPosFromLight.xyz / currentPosFromLight.w;
        projCoords = projCoords * 0.5 + 0.5;

        if(ValidProjectionCoordinates(projCoords))
        {
            float lightVisible =  texture(spotShadows[shadowIndex].spotShadowMap, projCoords.xy).r;
            // return spot.color.rgb * spot.color.a;

            if(projCoords.z < lightVisible)
            {
                const float attenuation = SpotLightAttenuation(spot, currentPosition);
                const vec3 spotColor = spot.color.rgb * spot.color.a * attenuation;

                float spotScattering = ScatteringPhaseFunction(-rayDirection, normalize(spot.direction), spot.anisotropy);

                light += spotColor * spotScattering;
            }
        }
    }
    
    return light;
}

float sampleIGN(vec2 pixelXY, float time)
{
    pixelXY += (time * 5.588238f );
    return fract(52.9829189f * fract(0.06711056f*float(pixelXY.x) + 0.00583715f*float(pixelXY.y)));
}

// INTERSECTION FUNCITONS -> NORMALIZE DIRECTION VECTORS!

bool IntersectPlane(in vec3 planeOrigin, in vec3 planeNormal, in vec3 rayOrigin, in vec3 rayDirection, out float t0)
{
    float denominator = dot(planeNormal, rayDirection);
    if(denominator > 1e-6)
    {
        vec3 vectorRayPlane = planeOrigin - rayOrigin;
        t0 = dot(vectorRayPlane, planeNormal) / denominator;
        return t0 >= 0;
    }

    return false;
}

bool IntersectDisk(in vec3 planeOrigin, in vec3 planeNormal, in float radius, in vec3 rayOrigin, in vec3 rayDirection, out float t0)
{
    if(IntersectPlane(planeOrigin, planeNormal, rayOrigin, rayDirection, t0))
    {
        vec3 intersectionPoint = rayOrigin + rayDirection * t0;
        vec3 planeIntersectVector = intersectionPoint - planeOrigin;
        float distanceSq = dot(planeIntersectVector, planeIntersectVector);

        return distanceSq <= (radius * radius);
    }

    return false;
}

// RETURNS NUMBER OF INTERSECTIONS, RESULT SHOULD BE 0, 1 OR 2;
// IF 0 -> DON'T USE T0 OR T1
// IF 1 -> USE T0
// IF 2 -> USE T0 AND T1
int ConeIntersection(in vec3 conePosition, in vec3 coneDirection, in float coneAngle, in float coneLength, in vec3 rayOrigin, in vec3 rayDirection, out float t0, out float t1)
{
    int totalIntersections = 0;

    float dotDV = dot(rayDirection, coneDirection);
    float coneCosine = cos(radians(coneAngle));
    vec3 CO = rayOrigin - conePosition;
    float dotCO_V = dot(CO, coneDirection);

    float a = dotDV * dotDV - coneCosine * coneCosine;
    float b = 2.0 * (dotDV * dotCO_V - dot(rayDirection, CO) * coneCosine * coneCosine);
    float c = dotCO_V * dotCO_V - dot(CO, CO) * coneCosine * coneCosine;

    float determinant = b*b - 4.0 * a * c;

    if(determinant == 0)
    {
        t0 = -b / (2 * a);

        vec3 point = conePosition + coneDirection * t0;
        float dist = dot(point - conePosition, coneDirection);

        if(dist > 0 && dist < coneLength) ++totalIntersections;
    }
    else if(determinant > 0)
    {
        float determinantSqrt = sqrt(determinant);
        
        //t0 check
        float auxTime = (-b - determinantSqrt) / (2.0 * a);
        vec3 point = conePosition + coneDirection * auxTime;
        float dist = dot(point - conePosition, coneDirection);

        if(dist > 0 && dist < coneLength)
        {
            t0 = auxTime;
            ++totalIntersections;
        }

        //t1 check
        auxTime = (-b + determinantSqrt) / (2.0 * a);
        point = conePosition + coneDirection * auxTime;
        dist = dot(point - conePosition, coneDirection);

        if(dist > 0 && dist < coneLength)
        {
            if(auxTime < t0)
            {
                t1 = t0;
                t0 = auxTime;
            }
            else
            {
                t1 = auxTime;
            }

            ++totalIntersections;
        }
    }

    return totalIntersections;
}

bool RayIntersectionPoints(in vec3 rayOrigin, in vec3 rayDirection, in int baseOffset, out float t0, out float t1)
{
    bool validIntersection = false;
    bool insideLight = false; // IF ONLY 1 INTERSECTION IS RECIEVED IT MEANS WE ARE INSIDE THE LIGHT FRUSTUM

    // SPOT LIGHTS
    for(int i = 0; i < tileLightCount; ++i)
    {
        SpotLight spot = tileSpotLights[i];
        float auxT0 = 0.0, auxT1 = 0.0;
        vec3 lightDirection = normalize(spot.direction);

        int totalIntersections = ConeIntersection(spot.position.xyz, lightDirection,  spot.outerAngle, spot.position.w, rayOrigin, rayDirection, auxT0, auxT1);
        if(totalIntersections >= 1)
        {
            t0 = min(t0, auxT0);
            t1 = max(t1, auxT0);

            if(totalIntersections == 2)
            {
                t0 = min(t0, auxT1);
                t1 = max(t1, auxT1);
            }
        }

        if(IntersectDisk(spot.position.xyz, -lightDirection, spot.radius, rayOrigin, rayDirection, auxT0))
        {
            t0 = min(t0, auxT0);
            t1 = max(t1, auxT0);
            ++totalIntersections;
        }

        if(totalIntersections > 0 && !validIntersection) validIntersection = true;

        if(totalIntersections == 1) insideLight = true;
    }
    if(insideLight) t0 = 0.0;
    return validIntersection;
}

