#version 460

#define M_PI 3.14159265358979323846

uniform layout(binding = 0) writeonly image2D transmitanceTexture;
uniform layout(binding = 1) sampler2D depthTexture;
uniform layout(binding = 2) sampler2D directionalLightShadowTexture;
uniform layout(binding = 3) sampler2D sceneTexture;


uniform layout(location = 0) mat4 projection;
uniform layout(location = 1) mat4 inverseViewMatrix;
uniform layout(location = 2) vec3 cameraPosition;

uniform layout(location = 3) int NUM_STEPS;
uniform layout(location = 4) float fogIntensity;
uniform layout(location = 5) float extinctionCoefficient;
uniform layout(location = 6) float time;
uniform layout(location = 7) float noiseAmmount;
uniform layout(location = 8) float anisotropy;

