// SCENE WITH INTERSECTION CALCULATIONS
void main()
{
    const ivec2 textureSize = imageSize(transmitanceTexture);
    if(gl_GlobalInvocationID.x >= textureSize.x || gl_GlobalInvocationID.y >= textureSize.y)
        return;

    ivec2 tileCoord = ivec2(gl_GlobalInvocationID.xy) / TILE_SIZE;
    int baseOffset = (tileCoord.y * numTilesX + tileCoord.x) * MAX_LIGHTS_PER_TILE;

    vec2 invTextureSize = 1.0 / vec2(textureSize);
    vec2 uvCoords = vec2(gl_GlobalInvocationID.xy) * invTextureSize;

    float depth = textureLod(depthTexture, uvCoords, 0).r;

    vec3 worldPosition = GetWorldPosition(depth, uvCoords); 
    vec3 rayDirection = worldPosition - cameraPosition;
    float maxDistance = length(rayDirection);
    rayDirection = rayDirection / maxDistance;

    if(gl_LocalInvocationIndex == 0) {
        tileLightCount = 0;
        for(int i=0; i < MAX_LIGHTS_PER_TILE; ++i){
            int idx = visibleIndices[baseOffset + i];
            if(idx == -1) break;
            bool isSpot = (idx & 0x80000000) != 0;
            int realIdx = idx & 0x7FFFFFFF;
            if(isSpot){
                tileSpotLights[tileLightCount++] = spotLights[realIdx];
            }
        }
    }
    memoryBarrierShared();
    barrier();

    float t0 = 0.0, t1 = maxDistance;  
    float marchDistance = t1 - t0;
    float numStepsFloat = marchDistance / StepSize;
    numStepsFloat = min(numStepsFloat, float(MAX_MARCH_STEPS));
    int numSteps = int(numStepsFloat);
    
    float actualStepSize = marchDistance / float(numSteps);
    vec3 marchingStep = rayDirection * actualStepSize;
    
    float jitter = sampleIGN(gl_GlobalInvocationID.xy, frameTime);
    vec3 currentPosition = cameraPosition + rayDirection * (t0 + actualStepSize * jitter);

    float accExtinction = 0.0;
    vec3 accScattering = vec3(0.0);

    float noise = useNoiseTex ? texture(noiseTexture, uvCoords + frameTime).r : noise(currentPosition, frameTime);
    float extinction = extinctionCoefficient * noise * noiseAmmount;

    for(int i = 0; i < numSteps; ++i)
    {
        accExtinction += extinction;
        
        if(accExtinction > EXTINCTION_THRESHOLD)
            break;
        
        vec3 scattering = CalculateInScattering(currentPosition, rayDirection, baseOffset);
        
        if(dot(scattering, scattering) > 0.0001)
        {
            float transmittance = exp(-accExtinction);
            accScattering += scattering * actualStepSize * transmittance;
        }
        
        currentPosition += marchingStep;
    }

    vec3 finalColor = accScattering * fogIntensity;
    imageStore(transmitanceTexture, ivec2(gl_GlobalInvocationID.xy), vec4(finalColor, 1.0));
}