uniform layout(location = 5) float extinctionCoefficient;
uniform layout(location = 6) float frameTime;
uniform layout(location = 7) float noiseAmmount;
// uniform layout(location = 8) float anisotropy; -> MOVED TO EACH SPOTLIGHT FOR BETTER CUSTOMIZATION
uniform layout(location = 9) int numTilesX;
uniform layout(location = 10) float StepSize;

// DIRECTIONAL LIGHT MATRICES -> MOVE TO UNIFORM OF DIRECTIONAL
uniform layout(location = 11) mat4 directinal_View_Mat;
uniform layout(location = 12) mat4 directinal_Projection_Mat;

struct PointLight
{
	vec4 position;		// xyz = position & w = range
	vec4 color;			// rgb = color & alpha = intensity 
};

struct SpotLight
{
	vec4 position;		// xyz = position & w = range
	vec4 color;			// rgb = color & alpha = intensity
	vec3 direction;	
	float innerAngle;
	float outerAngle;
	int spotShadowIndex;
    float radius;
    float anisotropy;
};

struct VisibleIndex {
	int index;
};

struct SpotShadow {
	mat4 shadowViewProj;
    sampler2D spotShadowMap;
};

struct VolumetricArea
{
	vec4 position;		// xyz = position & w = type -> 0 AABB | 1 SPHERE
	vec4 size;			// if type == 1 -> radius = size.x
};

